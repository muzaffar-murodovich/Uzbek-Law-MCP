# Copy to .env and adjust. Local dev: Homebrew postgresql@17 + pgvector on port 5433.
QONUNSHUNOS_DSN=postgresql://qonunshunos:qonunshunos@127.0.0.1:5433/qonunshunos
# Database for integration tests (pytest -m db); it is wiped by the tests.
QONUNSHUNOS_TEST_DSN=postgresql://qonunshunos:qonunshunos@127.0.0.1:5433/qonunshunos_test

# OAuth (stage 4). Public URL = issuer and resource; leave empty locally (http://localhost:PORT).
# QONUNSHUNOS_PUBLIC_URL=https://qonunshunos.muzaffar.zip
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local only: a "test user" sign-in button instead of Google. Never on a public server.
QONUNSHUNOS_DEV_LOGIN=1
