# Copy to .env and adjust. Local dev: Homebrew postgresql@17 + pgvector on port 5433.
NIZOM_DSN=postgresql://qonunshunos:qonunshunos@127.0.0.1:5433/qonunshunos
# Database for integration tests (pytest -m db); it is wiped by the tests.
NIZOM_TEST_DSN=postgresql://qonunshunos:qonunshunos@127.0.0.1:5433/qonunshunos_test

# OAuth (stage 4). Public URL = issuer and resource; leave empty locally (http://localhost:PORT).
# NIZOM_PUBLIC_URL=https://nizom.org
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local only: a "test user" sign-in button instead of Google. Never on a public server.
NIZOM_DEV_LOGIN=1
# E-mail or URL for privacy requests, shown on /maxfiylik and /shartlar.
NIZOM_CONTACT=

# Operator alerts and the morning report (stage 5): a bot from @BotFather and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Where deploy/backup.sh writes dumps (default ~/backups); the morning report looks there.
# NIZOM_BACKUPS_DIR=
