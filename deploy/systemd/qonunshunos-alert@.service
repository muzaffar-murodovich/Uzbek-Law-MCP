[Unit]
Description=Qonunshunos: Telegram alert for failed %i

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/qonunshunos
# deploy is in the adm group, so it can read the unit's journal.
ExecStart=/bin/sh -c '{ echo "❌ myserver: %i xato bilan tugadi"; journalctl -u %i -n 15 --no-pager -o cat; } | /home/deploy/qonunshunos/venv/bin/qonunshunos notify'
NoNewPrivileges=true
