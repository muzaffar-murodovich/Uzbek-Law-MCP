[Unit]
Description=Qonunshunos: expired OAuth rows and old query texts
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=qonunshunos-alert@%n.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/qonunshunos
ExecStart=/home/deploy/qonunshunos/venv/bin/qonunshunos auth-cleanup
Nice=10
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=10min
